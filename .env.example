# Copy this file to ".env" and fill in your real key. Never commit ".env".

# Google AI Studio (Gemini) API key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_api_key_here

# Chat model used to write answers (pick a free-tier-compatible Gemini model)
GEMINI_MODEL=gemini-2.5-flash

# Embedding model used to turn text into vectors
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Number of chunks retrieved for every question
TOP_K=4

# Chunking: characters per chunk and overlap between neighbouring chunks
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# Relevance safeguard: MAXIMUM cosine distance a chunk may have to be used
# (lower distance = more similar). This is a practical starting point, not a
# validated confidence score. Tune it with: python answer.py "your question"
RELEVANCE_THRESHOLD=0.65

# Copy this file to ".env" if you want to override any defaults.
# This app runs fully locally: there is NO AI API and NO API key to set.

# Where the knowledge-base Markdown files live (default: ./knowledge-base)
# KNOWLEDGE_BASE_PATH=knowledge-base

# Where the generated local search index is saved (default: ./kb_index.joblib)
# INDEX_PATH=kb_index.joblib

# Number of chunks retrieved for every question (default 4)
TOP_K=4

# Chunking: characters per chunk and overlap between neighbouring chunks
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# Relevance safeguard: MINIMUM cosine similarity (0-1) a chunk must reach to be
# used. Higher = stricter. If nothing reaches it, the bot returns the fallback
# instead of guessing. Tune it with: python answer.py "your question"
SIMILARITY_THRESHOLD=0.10
